# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# PostgreSQL
POSTGRES_USER=trialterminator
POSTGRES_PASSWORD=secret
POSTGRES_DB=trialterminator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_ADDR=localhost:6379

# API Server
SERVER_PORT=8080

# Auth (docs/design/001-auth-and-worker-api.md)
# PUBLIC_API_URL is the API's browser-facing URL; Google redirects back to
# PUBLIC_API_URL/v1/auth/google/callback, so register that in the Google
# Cloud console. https here turns on Secure cookies.
PUBLIC_API_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3000
# Comma-separated; defaults to FRONTEND_URL.
# ALLOWED_ORIGINS=
# Sign in as any email without Google. Refused when ENV=production.
DEV_LOGIN=true
# ENV=production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Worker — Gemini vision agent (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
